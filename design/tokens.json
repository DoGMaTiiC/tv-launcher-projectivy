{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Uma linguagem de tela para 3 metros de distancia, derivada dos principios publicos do tvOS (HIG) e implementada em Views Android.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.961,
          0.961,
          0.969
        ],
        "hex": "#f5f5f7"
      }
    },
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "hex": "#000000"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043,
          0.043,
          0.047
        ],
        "hex": "#0b0b0c"
      }
    },
    "surface-elevated": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.086,
          0.086,
          0.094
        ],
        "hex": "#161618"
      }
    },
    "on-surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.961,
          0.961,
          0.969
        ],
        "hex": "#f5f5f7"
      }
    },
    "on-surface-secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.631,
          0.631,
          0.651
        ],
        "hex": "#a1a1a6"
      }
    },
    "focus-glow": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "glass-fill": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff14"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.039,
          0.518,
          1
        ],
        "hex": "#0a84ff"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "xxl": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "safe": {
      "$value": {
        "value": 60,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 28,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Outfit",
        "fontSize": {
          "value": 64,
          "unit": "px"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Outfit",
        "fontSize": {
          "value": 48,
          "unit": "px"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Outfit",
        "fontSize": {
          "value": 38,
          "unit": "px"
        },
        "fontWeight": 500
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Outfit",
        "fontSize": {
          "value": 29,
          "unit": "px"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Outfit",
        "fontSize": {
          "value": 25,
          "unit": "px"
        },
        "fontWeight": 500
      }
    }
  }
}
